{
  "name": "oda",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @oda/db db:generate",
    "db:migrate": "pnpm --filter @oda/db db:migrate",
    "db:seed": "pnpm --filter @oda/db db:seed",
    "db:studio": "pnpm --filter @oda/db db:studio",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  }
}
