{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [
    "eslint.config.mjs",
    "tsconfig.base.json",
    "package.json",
    "pnpm-workspace.yaml",
    ".nvmrc",
    "turbo.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "PUBLIC_SHOP_BASE_URL", "VERCEL_GIT_COMMIT_SHA"],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN",
        "CI",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_REF",
        "BETTER_AUTH_URL",
        "STORAGE_DRIVER",
        "STORAGE_PUBLIC_BASE_URL",
        "EMAIL_TRANSPORT",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "BETTER_AUTH_SECRET",
        "CRON_SECRET",
        "OPS_SECRET",
        "EXPO_ACCESS_TOKEN",
        "ODA_SHOPS_INDEXABLE"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["DATABASE_URL"]
    },
    "@oda/web#test": {
      "dependsOn": ["transit"],
      "env": ["DATABASE_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/seller/assets/brands/**",
        "$TURBO_ROOT$/apps/seller/assets/flags/**"
      ]
    },
    "@oda/seller#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/help-guides.md"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "PUBLIC_SHOP_BASE_URL", "E2E_PORT"],
      "cache": false
    }
  }
}
