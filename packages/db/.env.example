# Copy to .env.local. Local default matches docker-compose.yml.
DATABASE_URL=postgres://oda:oda@localhost:5442/oda
# Neon only: the direct (unpooled) URL, used for migrations. Leave unset locally.
# DATABASE_URL_UNPOOLED=
# Tests use DATABASE_URL with the database renamed to oda_test (apps/web) and oda_db_test
# (packages/db), both created and migrated automatically.
