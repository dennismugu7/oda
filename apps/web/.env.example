# Copy to .env.local. Server-only values: never prefix these with NEXT_PUBLIC_.

# Local Docker Postgres (docker-compose.yml). On Vercel: Neon's POOLED connection string.
DATABASE_URL=postgres://oda:oda@localhost:5442/oda

# Base for shop links, e.g. https://oda.mugu-labs.com in production. No trailing slash.
PUBLIC_SHOP_BASE_URL=http://localhost:3000

