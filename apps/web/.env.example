# Copy to .env.local. Server-only values: never prefix these with NEXT_PUBLIC_.

# Local Docker Postgres (docker-compose.yml). On Vercel: Neon's POOLED connection string.
DATABASE_URL=postgres://oda:oda@localhost:5442/oda

# Base for shop links, e.g. https://oda.mugu-labs.com in production. No trailing slash.
PUBLIC_SHOP_BASE_URL=http://localhost:3000

# Better Auth (/api/auth). Tests use a throwaway secret. Local: any 32+ characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# On Vercel: set BETTER_AUTH_SECRET and BETTER_AUTH_URL (https://oda-eta.vercel.app) in the dashboard.
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789
# Base for links in emails (reset password). Through `adb reverse tcp:3000 tcp:3000` the
# phone opens localhost:3000 links on this computer.
BETTER_AUTH_URL=http://localhost:3000

# Email (decision #43). Locally emails go to .outbox/ and http://localhost:3000/dev/outbox
# (no key needed). On Vercel: RESEND_API_KEY and EMAIL_FROM, set in the dashboard.
# EMAIL_TRANSPORT=file
# RESEND_API_KEY=
# EMAIL_FROM=oda <hello@mail.oda.mugu-labs.com>

# `pnpm db:seed` (local database only): password for amani@example.test and admin@example.test.
# A local development password, never used on staging or production.
SEED_PASSWORD=oda-local-dev-2026

# Photo storage (decisions #52, #54). Locally: files in .uploads/ via /api/dev-uploads (no
# key needed). Staging (Vercel dashboard, Production + Preview): a public Vercel Blob store,
# STORAGE_DRIVER=vercel-blob and STORAGE_PUBLIC_BASE_URL=https://<store-id>.public.blob.vercel-storage.com;
# connecting the store adds BLOB_STORE_ID (+ OIDC) and BLOB_READ_WRITE_TOKEN by itself.
# Production (M11): an S3-compatible bucket (Cloudflare R2). Without a driver, uploads answer 503.
# STORAGE_DRIVER=local
# STORAGE_DIR=.uploads
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=oda-staging
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=https://pub-<id>.r2.dev   (staging only; production: own domain, M11)

# Added in later milestones:
# CRON_SECRET=                   (M6)
# ODA_SUPPORT_WHATSAPP=          (M8)

# Landing page store button (decision #59): unset = "Coming soon to Google Play"; set to a public
# https link (e.g. the Play Store listing or an APK) to show a real download button.
# APP_DOWNLOAD_URL=
