# Copy to .env.local. Server-only values: never prefix these with NEXT_PUBLIC_.

# Local Docker Postgres (docker-compose.yml). On Vercel: Neon's POOLED connection string.
DATABASE_URL=postgres://oda:oda@localhost:5442/oda

# Base for shop links, e.g. https://oda.mugu-labs.com in production. No trailing slash.
PUBLIC_SHOP_BASE_URL=http://localhost:3000

# Better Auth (server core since M1; /api/auth arrives in M2). Tests use a throwaway secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Added in later milestones:
# RESEND_API_KEY=                (M2)
# R2_ACCOUNT_ID=                 (M2/M3)
# R2_ACCESS_KEY_ID=              (M2/M3)
# R2_SECRET_ACCESS_KEY=          (M2/M3)
# R2_BUCKET=oda-staging          (M2/M3)
# R2_PUBLIC_BASE_URL=            (M2/M3)
# CRON_SECRET=                   (M6)
# ODA_SUPPORT_WHATSAPP=          (M8)
