# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# The oda API (apps/web). Redmi over wireless debugging: http://localhost:3000, after
# `adb reverse tcp:3000 tcp:3000` (the phone's localhost:3000 is then this computer's).
# Emulator: http://10.0.2.2:3000. Staging: https://oda-eta.vercel.app.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Base for shop links shown to the seller (same value as the web's PUBLIC_SHOP_BASE_URL).
EXPO_PUBLIC_SHOP_BASE_URL=http://localhost:3000
